# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Authentication (Required for multi-user)
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend URL (for OAuth callback)
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL — Supabase or any provider)
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/your_database

# Encryption key for API keys and lab values (required)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# Data Directory
DATA_DIR=./data
